# ════════════════════════════════════════════════════════════════════════
# Munshi / Jainpur Logistic — environment variables
# ════════════════════════════════════════════════════════════════════════
# Copy this file to ".env" and fill in your real values.
# DO NOT commit .env to git — it's gitignored for a reason.

# ── AI extraction (Google Gemini 2.5 Flash for OCR) ─────────────────────
# Get a free key at https://aistudio.google.com/apikey
# The app runs WITHOUT this key, but Extract-from-Photo features are disabled.
GOOGLE_API_KEY=

# ── License server (Munshi commercial only) ─────────────────────────────
# For the in-house install, leave EMPTY — app runs in unlicensed mode (works).
# For Munshi customers, point at the production license server, e.g.
#   https://license.munshi.in
LICENSE_SERVER_URL=

# Require a license even when LICENSE_SERVER_URL is empty (default OFF).
# OFF: no server/key → app runs unrestricted (free-trial pilots, in-house use).
# ON (MUNSHI_REQUIRE_LICENSE=1): no key → app goes read-only, so a paying
# customer can't bypass payment by deleting the LICENSE_SERVER_URL line.
# Flip this ON only when you start charging.
# MUNSHI_REQUIRE_LICENSE=

# ── Google Drive backup (optional) ───────────────────────────────────────
# Set up a Google Cloud project + OAuth Desktop client (see OPS_RUNBOOK §2.4).
# These two env vars enable the "Connect Google Drive" button in Settings.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Flask session signing key (advanced) ─────────────────────────────────
# Normally auto-generated per install in .flask_secret. Override here only
# if you want to share session state across multiple instances (rare).
# FLASK_SECRET_KEY=

# ── App port (default 5056) ──────────────────────────────────────────────
# PORT=5056

# ── Gemini model override (default: gemini-flash-latest) ────────────────
# gemini-flash-latest is Google's floating alias for their current
# recommended flash model — it auto-migrates as Google retires older
# versions (e.g. gemini-2.5-flash was retired for new API keys). Prefer
# leaving this unset unless you need to pin an exact model version.
# GEMINI_MODEL=gemini-flash-latest
